{
  "title": "Boot Animation",
  "author": "Yomni; adapted from Modera contributors",
  "category": "personalization",
  "icon": "data:image/png;base64,",
  "permissions": [
    "yomni.storage.read",
    "yomni.storage.write"
  ],
  "extensions": [
    "yomni.window.overlay",
    "yomni.sidebar.footer.action"
  ],
  "locales": {
    "zh-CN": {
      "name": "片头动画",
      "description": "启动时或进入指定会话时播放可自定义的视频片头。"
    }
  },
  "requiresHost": {
    "yomni.plugin.declarations": 2,
    "yomni.extension.window.overlay": 2,
    "yomni.context.public": 1,
    "yomni.picker.files": 1
  },
  "declarations": {
    "provides": {
      "ui": [
        {
          "id": "yomni.boot-animation.overlay",
          "slot": "yomni.window.overlay",
          "description": "Video playback and clip library"
        },
        {
          "id": "yomni.boot-animation.controls",
          "slot": "yomni.sidebar.footer.action",
          "description": "Open the clip library and pin this conversation"
        }
      ]
    }
  }
}
